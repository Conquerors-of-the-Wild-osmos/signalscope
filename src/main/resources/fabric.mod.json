{
	"schemaVersion": 1,
	"id": "signalscope",
	"version": "${version}",
	"name": "Signalscope",
	"description": "Turn your radio into a beacon and your voice into a signal. Broadcast across your world, then use the Signalscope to locate transmissions, track their direction, and tune into distant voices. Can you find who's calling?",
	"authors": [
		"nutsalhan87"
	],
    "contributors": [
        "Space_27",
        "_usopshiy_",
        "COSMOGLIST"
    ],
	"contact": {
		"issues": "https://github.com/Conquerors-of-the-Wild-osmos/signalscope/issues",
		"sources": "https://github.com/Conquerors-of-the-Wild-osmos/signalscope"
	},
	"license": "CC0-1.0",
	"icon": "assets/signalscope/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ru.itmo.ipkn.signalscope.Signalscope"
		],
		"client": [
			"ru.itmo.ipkn.signalscope.client.ConfigClient",
			"ru.itmo.ipkn.signalscope.client.SignalscopeClient"
		],
		"voicechat": [
			"ru.itmo.ipkn.signalscope.voice.RadioVoicechatPlugin"
		]
	},
	"mixins": [
		"signalscope.mixins.json",
		{
			"config": "signalscope.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*",
		"voicechat": "*",
		"voicechat_api": ">=2.6.20",
		"yet_another_config_lib_v3": ">=3.8.2"
	}
}
